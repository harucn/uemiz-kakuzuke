{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kakuzuke",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "assets": {
    "html_handling": "drop-trailing-slash"
  },
  "durable_objects": {
    "bindings": [{ "name": "VENUE", "class_name": "Venue" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Venue"] }],
  "secrets": { "required": ["HOST_PASSWORD"] },
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "VENUE", "class_name": "Venue" }]
    }
  }
}
